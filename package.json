{
  "name": "stardew-save-analyzer",
  "private": true,
  "version": "0.7.1-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite optimize --force && vavite serve",
    "format": "prettier --loglevel warn --write \"{common,frontend,server,pages}/**/*.{tsx,ts,jsx,js}\"",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "build": "pnpm i && vavite build",
    "start": "cross-env NODE_ENV=production HOST=0.0.0.0 node dist/server/index.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.27.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "case-anything": "^2.1.13",
    "clsx": "^2.1.1",
    "color-scales": "^3.0.2",
    "express": "^4.21.2",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-compound-composer": "^1.5.1",
    "react-dom": "^18.3.1",
    "react-drag-drop-files": "^2.4.0",
    "remeda": "^1.61.0",
    "ts-toolbelt": "^9.6.0",
    "usehooks-ts": "^3.1.0",
    "vike": "^0.4.218",
    "vike-react": "^0.5.11",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@originjs/vite-plugin-content": "^1.0.5",
